# Variables de ejemplo para el entorno local con Docker Compose (ADR 0005).
# Copia este archivo a `.env` antes de ejecutar `docker compose up --wait`.
# Nunca subas `.env` ni valores reales al repositorio.

ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL 16 local (Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ejemplo-postgres-solo-local
MG_ADMIN_PASSWORD=ejemplo-admin-solo-local
MG_MIGRATOR_PASSWORD=ejemplo-migrator-solo-local

# Conexión de la API
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=monitorglucosa
DATABASE_USER=mg_api
DATABASE_PASSWORD=ejemplo-api-solo-local
DATABASE_CONNECT_TIMEOUT_S=20

# Emisor JWT de pruebas local (sustituye a Cognito en local)
LOCAL_JWT_ISSUER=http://jwt-issuer:9000
LOCAL_JWKS_URL=http://jwt-issuer:9000/.well-known/jwks.json
LOCAL_JWT_CLIENT_IDS=web,collector

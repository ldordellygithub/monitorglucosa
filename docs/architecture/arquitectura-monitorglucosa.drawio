        </mxCell>
        <mxCell id="ciclo-de-vida-datos-why" value="&lt;b&gt;¿Por qué el registro de supresiones vive en S3?&lt;/b&gt;&lt;br&gt;Si estuviera en Aurora, restaurar un backup anterior al borrado también lo haría retroceder y lo borrado reaparecería." style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C8CDD3;fontSize=10;fontColor=#2B3A4A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;kiroRole=leaf;" parent="ciclo-de-vida-datos-1" vertex="1">

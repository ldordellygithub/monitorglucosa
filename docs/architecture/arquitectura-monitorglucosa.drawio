        <mxCell id="secuencia-sincronizacion-s26" value="&lt;b&gt;422 READING_INVALID&lt;/b&gt;: registra index y campo; no reintenta ese lote" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF4FB;strokeColor=#7FA7D1;fontSize=10;fontColor=#1B2A3A;align=left;spacingLeft=6;spacingRight=6;kiroRole=leaf;" parent="secuencia-sincronizacion-1" vertex="1">

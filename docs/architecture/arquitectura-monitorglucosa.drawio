        <mxCell id="contexto-gd50" value="&lt;b&gt;GlucoQuick GD50&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Dispositivo · BLE]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Glucómetro capilar. Guarda las lecturas y las expone por el perfil Glucose (0x1808) y RACP.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#999999;strokeColor=#6E6E6E;fontColor=#FFFFFF;fontSize=11;kiroRole=leaf;" parent="contexto-1" vertex="1">
          <mxGeometry x="250" y="790" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="contexto-sys" value="&lt;b&gt;monitorglucosa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Sincroniza las lecturas del GD50, guarda el historial sin duplicados, lo muestra con gráficas, avisa cuando una lectura cruza un umbral y genera informes.&lt;br&gt;&lt;br&gt;Colector local · web estática · API en AWS sa-east-1&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=11;fontSize=12;kiroRole=leaf;" parent="contexto-1" vertex="1">
          <mxGeometry x="820" y="400" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="contexto-cog" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo · identidad]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Inicio de sesión con MFA TOTP (web) y PKCE (colector).&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;kiroRole=leaf;" parent="contexto-1" vertex="1">
          <mxGeometry x="1420" y="150" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="contexto-gh" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo · código y CI/CD]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Repositorio y GitHub Actions; despliega en AWS con OIDC, sin claves largas.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;kiroRole=leaf;" parent="contexto-1" vertex="1">

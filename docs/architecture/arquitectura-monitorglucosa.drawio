        <mxCell id="contexto-luis" value="&lt;b&gt;Luis&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Usuario propietario. Mide su glucemia, consulta su historial y recibe avisos." style="fontFamily=Helvetica;shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;kiroRole=leaf;" parent="contexto-1" vertex="1">
          <mxGeometry x="260" y="400" width="220" height="190" as="geometry" />
        </mxCell>
        <mxCell id="contexto-med" value="&lt;b&gt;Médico de Luis&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona externa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;No usa el sistema. Recibe el informe PDF que Luis le entrega." style="fontFamily=Helvetica;shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;fillColor=#6B6477;strokeColor=#4D4D4D;fontColor=#FFFFFF;fontSize=11;kiroRole=leaf;" parent="contexto-1" vertex="1">

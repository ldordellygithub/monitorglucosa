        <mxCell id="red-y-despliegue-roles" value="&lt;b&gt;Roles IAM (mínimo privilegio)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Ejecución de la API&lt;/b&gt;&lt;br&gt;rds-db:connect a su usuario · s3:PutObject en informes · logs&lt;br&gt;&lt;br&gt;&lt;b&gt;Despliegue&lt;/b&gt; (OIDC: solo tu repo y el entorno prod)&lt;br&gt;push a ECR · terraform plan/apply del proyecto&lt;br&gt;&lt;br&gt;&lt;b&gt;Prueba de humo&lt;/b&gt;&lt;br&gt;execute-api:Invoke solo en /health/ready&lt;br&gt;&lt;br&gt;&lt;b&gt;Auditoría&lt;/b&gt;: historial de CloudTrail (90 días)&lt;br&gt;&lt;br&gt;Nunca &lt;i&gt;Action: &quot;*&quot;&lt;/i&gt; ni &lt;i&gt;Resource: &quot;*&quot;&lt;/i&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C8CDD3;fontSize=10;fontColor=#2B3A4A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;kiroRole=leaf;" parent="red-y-despliegue-1" vertex="1">
          <mxGeometry x="1530" y="550" width="300" height="290" as="geometry" />
        </mxCell>
        <mxCell id="red-y-despliegue-cfg" value="&lt;b&gt;Configuración de la Lambda (T-11)&lt;/b&gt;&lt;br&gt;Sin NAT, la Lambda no alcanza Parameter Store ni Secrets Manager en ejecución. Terraform lee la configuración al desplegar y la inyecta como variables de entorno cifradas con KMS de AWS. Nunca contienen secretos." style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8DC;strokeColor=#D6B656;fontSize=10;fontColor=#3A3A3A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;kiroRole=leaf;" parent="red-y-despliegue-1" vertex="1">
          <mxGeometry x="1530" y="855" width="300" height="135" as="geometry" />
        </mxCell>
        <mxCell id="red-y-despliegue-paths" value="&lt;b&gt;Cómo funciona sin salida a internet&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;API Gateway → Lambda&lt;/b&gt;: invocación del servicio Lambda, no tráfico de la VPC.&lt;br&gt;• &lt;b&gt;JWKS de Cognito&lt;/b&gt;: los consulta API Gateway; la Lambda no los necesita.&lt;br&gt;• &lt;b&gt;Aurora&lt;/b&gt;: TLS dentro de la VPC con token IAM firmado localmente; una conexión por petición para permitir la pausa.&lt;br&gt;• &lt;b&gt;S3 informes&lt;/b&gt;: por el endpoint gateway (sin NAT y sin coste).&lt;br&gt;• &lt;b&gt;ECR y CloudWatch Logs&lt;/b&gt;: los gestiona el servicio Lambda (descarga de la imagen y envío de logs)." style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C8CDD3;fontSize=10;fontColor=#2B3A4A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;kiroRole=leaf;" parent="red-y-despliegue-1" vertex="1">
          <mxGeometry x="870" y="1000" width="960" height="130" as="geometry" />
        </mxCell>

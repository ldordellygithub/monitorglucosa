        </mxCell>
        <mxCell id="secuencia-sincronizacion-s28" value="&lt;b&gt;503 DATABASE_UNAVAILABLE / 5xx&lt;/b&gt;: respeta Retry-After (5 s) hasta 60 s (ADR 0009)" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF4FB;strokeColor=#7FA7D1;fontSize=10;fontColor=#1B2A3A;align=left;spacingLeft=6;spacingRight=6;kiroRole=leaf;" parent="secuencia-sincronizacion-1" vertex="1">
          <mxGeometry x="330" y="1124" width="310" height="38" as="geometry" />
        </mxCell>
        <mxCell id="secuencia-sincronizacion-m31" value="desconecta" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#2B3A4A;strokeWidth=1.2;fontSize=10;fontColor=#1B2A3A;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" parent="secuencia-sincronizacion-1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="1210" as="sourcePoint" />
            <mxPoint x="720" y="1210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="secuencia-sincronizacion-m32" value="notificación de escritorio: resumen y avisos diferidos (f3)" style="fontFamily=Helvetica;html=1;endArrow=block;endFill=1;strokeColor=#2B3A4A;strokeWidth=1.2;fontSize=10;fontColor=#1B2A3A;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" parent="secuencia-sincronizacion-1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="1244" as="sourcePoint" />
            <mxPoint x="120" y="1244" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="secuencia-sincronizacion-notes" value="&lt;b&gt;Reglas del flujo&lt;/b&gt;&lt;br&gt;&lt;br&gt;• La garantía contra duplicados entre BLE y respaldo local es la restricción &lt;b&gt;UNIQUE&lt;/b&gt; (T-9).&lt;br&gt;&lt;br&gt;• Nunca «consultar y luego insertar».&lt;br&gt;&lt;br&gt;• Lotes &lt;b&gt;atómicos&lt;/b&gt;: una lectura inválida → 422 y no se guarda nada.&lt;br&gt;&lt;br&gt;• Contrato de reanudación de Aurora: 503 con Retry-After: 5, reintentos del cliente hasta 60 s (ADR 0009).&lt;br&gt;&lt;br&gt;&lt;b&gt;Métricas por sesión&lt;/b&gt;&lt;br&gt;≥ 95 % de sesiones BLE e iniciadas completadas sin error; 0 lecturas perdidas.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pendientes&lt;/b&gt;&lt;br&gt;• Composición final de la clave T-9 y zona horaria del GD50 (T-1) en fase-1b." style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8DC;strokeColor=#D6B656;fontSize=10;fontColor=#3A3A3A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;kiroRole=leaf;" parent="secuencia-sincronizacion-1" vertex="1">
          <mxGeometry x="1640" y="110" width="260" height="430" as="geometry" />
        </mxCell>
        <mxCell id="secuencia-sincronizacion-hdr" value="" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;kiroRole=decor;" parent="secuencia-sincronizacion-1" vertex="1">
          <mxGeometry x="0" y="0" width="1920" height="78" as="geometry" />
        </mxCell>
        <mxCell id="secuencia-sincronizacion-hdr-t" value="&lt;b&gt;Secuencia · sincronización e importación dual (fase 1)&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#FFFFFF;kiroRole=decor;" parent="secuencia-sincronizacion-1" vertex="1">
          <mxGeometry x="30" y="8" width="1560" height="36" as="geometry" />
        </mxCell>
        <mxCell id="secuencia-sincronizacion-hdr-s" value="Del GD50 o respaldo local a Aurora sin duplicados ni pérdidas · tech.md «Sincronización» · ADR 0001, 0002, 0004, 0009 y 0011" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#C9D3DD;kiroRole=decor;" parent="secuencia-sincronizacion-1" vertex="1">

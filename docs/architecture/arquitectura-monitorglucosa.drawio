        <mxCell id="contexto-luis" value="&lt;b&gt;Luis&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Usuario propietario. Mide su glucemia, registra insulina y anotaciones, consulta análisis y recibe avisos diferidos." style="fontFamily=Helvetica;shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;kiroRole=leaf;" parent="contexto-1" vertex="1">
          <mxGeometry x="260" y="400" width="220" height="190" as="geometry" />
        </mxCell>
        <mxCell id="contexto-med" value="&lt;b&gt;4 Especialistas de Luis&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Personas externas]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Endocrinólogo, oftalmólogo, médico general y odontólogo. Reciben un formato único de informe PDF." style="fontFamily=Helvetica;shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;fillColor=#6B6477;strokeColor=#4D4D4D;fontColor=#FFFFFF;fontSize=11;kiroRole=leaf;" parent="contexto-1" vertex="1">
          <mxGeometry x="260" y="120" width="220" height="190" as="geometry" />
        </mxCell>
        <mxCell id="contexto-gd50" value="&lt;b&gt;GlucoQuick GD50&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Dispositivo · BLE]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Glucómetro capilar. Guarda las lecturas (451 hoy) y las expone por el perfil Glucose (0x1808) y RACP.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#999999;strokeColor=#6E6E6E;fontColor=#FFFFFF;fontSize=11;kiroRole=leaf;" parent="contexto-1" vertex="1">
          <mxGeometry x="250" y="790" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="contexto-sys" value="&lt;b&gt;monitorglucosa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Sincroniza lecturas del GD50 e importa el respaldo local, registra dosis e inventario de insulina, anotaciones, patrones objetivos y avisos, y genera informes PDF (a1+) y exportaciones CSV/XLSX.&lt;br&gt;&lt;br&gt;Colector local · web estática · API en AWS us-east-1 (ADR 0011)&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=11;fontSize=12;kiroRole=leaf;" parent="contexto-1" vertex="1">
          <mxGeometry x="820" y="400" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="contexto-cog" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo · identidad]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Inicio de sesión con MFA TOTP (web) y PKCE (colector).&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;kiroRole=leaf;" parent="contexto-1" vertex="1">
          <mxGeometry x="1420" y="150" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="contexto-gh" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo · código y CI/CD]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Repositorio público (sin datos reales) y GitHub Actions; despliega en AWS con OIDC.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;kiroRole=leaf;" parent="contexto-1" vertex="1">

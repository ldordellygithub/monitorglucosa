        <mxCell id="observabilidad-sns" value="&lt;b&gt;SNS monitorglucosa-alarms&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Tema regional · sin KMS (D14)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Política: solo CloudWatch (SourceAccount + SourceArn) y Deny sin TLS. Solo metadatos de alarma, sin PII ni datos de salud.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;kiroRole=leaf;" parent="observabilidad-1" vertex="1">

        <mxCell id="secuencia-autenticacion-s28" value="El access token ya emitido sigue válido hasta expirar (≤ 60 min)" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF4FB;strokeColor=#7FA7D1;fontSize=10;fontColor=#1B2A3A;align=left;spacingLeft=6;spacingRight=6;kiroRole=leaf;" parent="secuencia-autenticacion-1" vertex="1">
          <mxGeometry x="930" y="970" width="310" height="30" as="geometry" />
        </mxCell>
        <mxCell id="secuencia-autenticacion-notes" value="&lt;b&gt;Reglas&lt;/b&gt;&lt;br&gt;&lt;br&gt;• El colector &lt;b&gt;nunca&lt;/b&gt; usa credenciales de AWS.&lt;br&gt;&lt;br&gt;• Plan &lt;b&gt;Essentials&lt;/b&gt;: la rotación no existe en Lite.&lt;br&gt;&lt;br&gt;• La rotación &lt;b&gt;no extiende&lt;/b&gt; la validez: cada 30 días, login completo.&lt;br&gt;&lt;br&gt;• MFA TOTP obligatorio, sin SMS. Sin códigos de respaldo: el reset lo hace el administrador.&lt;br&gt;&lt;br&gt;• Descartados: secreto local (client credentials), token estático y device authorization grant.&lt;br&gt;&lt;br&gt;&lt;b&gt;Referencias&lt;/b&gt;&lt;br&gt;T-4 · T-7 · ADR 0003" style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8DC;strokeColor=#D6B656;fontSize=10;fontColor=#3A3A3A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;kiroRole=leaf;" parent="secuencia-autenticacion-1" vertex="1">
          <mxGeometry x="1640" y="110" width="260" height="330" as="geometry" />
        </mxCell>
        <mxCell id="secuencia-autenticacion-hdr" value="" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;kiroRole=decor;" parent="secuencia-autenticacion-1" vertex="1">
          <mxGeometry x="0" y="0" width="1920" height="78" as="geometry" />
        </mxCell>
        <mxCell id="secuencia-autenticacion-hdr-t" value="&lt;b&gt;Secuencia · autenticación del colector (T-7)&lt;/b&gt;" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#FFFFFF;kiroRole=decor;" parent="secuencia-autenticacion-1" vertex="1">
          <mxGeometry x="30" y="8" width="1560" height="36" as="geometry" />
        </mxCell>
        <mxCell id="secuencia-autenticacion-hdr-s" value="PKCE, rotación de refresh tokens, cierre de sesión y equipo perdido · ADR 0003" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#C9D3DD;kiroRole=decor;" parent="secuencia-autenticacion-1" vertex="1">

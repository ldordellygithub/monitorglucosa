  <diagram id="contexto" name="1 · Contexto del sistema · C4 nivel 1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="contexto-0" />

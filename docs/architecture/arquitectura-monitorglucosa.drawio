        <mxCell id="secuencia-sincronizacion-s28" value="&lt;b&gt;Timeout o 5xx&lt;/b&gt;: backoff exponencial con jitter; no descarta lecturas" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF4FB;strokeColor=#7FA7D1;fontSize=10;fontColor=#1B2A3A;align=left;spacingLeft=6;spacingRight=6;kiroRole=leaf;" parent="secuencia-sincronizacion-1" vertex="1">

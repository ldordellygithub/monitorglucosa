        <mxCell id="secuencia-sincronizacion-ftr" value="Fuente: &lt;b&gt;.kiro/steering/ (product, tech, structure, discovery), docs/adr/ 0001–0011 y .kiro/specs/fase-1a-infraestructura-y-auth/&lt;/b&gt; · Propuesto y fases futuras en gris discontinuo" style="fontFamily=Helvetica;text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#7A8794;kiroRole=decor;" parent="secuencia-sincronizacion-1" vertex="1">

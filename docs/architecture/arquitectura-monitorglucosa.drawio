        <mxCell id="contexto-wa" value="&lt;b&gt;WhatsApp&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo · fase 4]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Avisos al número de Luis. Contenido según P-3.&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#F2F2F2;strokeColor=#999999;dashed=1;dashPattern=6 4;fontColor=#666666;fontSize=11;kiroRole=leaf;" parent="contexto-1" vertex="1">
